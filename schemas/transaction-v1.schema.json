{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cadencegraph:transaction:1",
  "title": "CadenceGraph Transaction v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"
    },
    "baseRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "actor": {
      "enum": [
        "human",
        "ai"
      ]
    },
    "operations": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "set-text"
              },
              "nodeId": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,95}$"
              },
              "locale": {
                "type": "string",
                "pattern": "^[a-z]{2,3}(?:-[A-Za-z]{2,8})?$"
              },
              "text": {
                "type": "string",
                "maxLength": 4000
              }
            },
            "required": [
              "type",
              "nodeId",
              "locale",
              "text"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "set-sentence-text"
              },
              "sentenceId": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,95}$"
              },
              "locale": {
                "type": "string",
                "pattern": "^[a-z]{2,3}(?:-[A-Za-z]{2,8})?$"
              },
              "text": {
                "type": "string",
                "maxLength": 4000
              }
            },
            "required": [
              "type",
              "sentenceId",
              "locale",
              "text"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "set-layout"
              },
              "nodeId": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,95}$"
              },
              "ratio": {
                "enum": [
                  "16:9",
                  "9:16"
                ]
              },
              "layout": {
                "$ref": "#/$defs/partialLayout",
                "minProperties": 1
              },
              "protect": {
                "type": "boolean"
              }
            },
            "required": [
              "type",
              "nodeId",
              "ratio",
              "layout"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "set-protection"
              },
              "nodeId": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,95}$"
              },
              "ratio": {
                "enum": [
                  "16:9",
                  "9:16"
                ]
              },
              "protected": {
                "type": "boolean"
              }
            },
            "required": [
              "type",
              "nodeId",
              "ratio",
              "protected"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "set-brand"
              },
              "brand": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "accent": {
                    "type": "string",
                    "pattern": "^(#(?:[a-fA-F0-9]{3}|[a-fA-F0-9]{4}|[a-fA-F0-9]{6}|[a-fA-F0-9]{8})|[a-zA-Z]{1,24})$"
                  },
                  "background": {
                    "type": "string",
                    "pattern": "^(#(?:[a-fA-F0-9]{3}|[a-fA-F0-9]{4}|[a-fA-F0-9]{6}|[a-fA-F0-9]{8})|[a-zA-Z]{1,24})$"
                  },
                  "foreground": {
                    "type": "string",
                    "pattern": "^(#(?:[a-fA-F0-9]{3}|[a-fA-F0-9]{4}|[a-fA-F0-9]{6}|[a-fA-F0-9]{8})|[a-zA-Z]{1,24})$"
                  },
                  "fontFamily": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "required": [],
                "minProperties": 1
              }
            },
            "required": [
              "type",
              "brand"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "set-sentence-duration"
              },
              "sentenceId": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,95}$"
              },
              "locale": {
                "type": "string",
                "pattern": "^[a-z]{2,3}(?:-[A-Za-z]{2,8})?$"
              },
              "duration": {
                "type": "number",
                "minimum": 0.2,
                "maximum": 120
              }
            },
            "required": [
              "type",
              "sentenceId",
              "locale",
              "duration"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "set-sentence-audio"
              },
              "sentenceId": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,95}$"
              },
              "locale": {
                "type": "string",
                "pattern": "^[a-z]{2,3}(?:-[A-Za-z]{2,8})?$"
              },
              "asset": {
                "$ref": "#/$defs/asset"
              },
              "duration": {
                "type": "number",
                "minimum": 0.2,
                "maximum": 120
              }
            },
            "required": [
              "type",
              "sentenceId",
              "locale",
              "asset",
              "duration"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "add-asset"
              },
              "asset": {
                "$ref": "#/$defs/asset"
              }
            },
            "required": [
              "type",
              "asset"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "add-node"
              },
              "sceneId": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,95}$"
              },
              "node": {
                "$ref": "#/$defs/node"
              }
            },
            "required": [
              "type",
              "sceneId",
              "node"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "remove-node"
              },
              "nodeId": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,95}$"
              }
            },
            "required": [
              "type",
              "nodeId"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "set-node-media"
              },
              "nodeId": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,95}$"
              },
              "asset": {
                "$ref": "#/$defs/asset"
              }
            },
            "required": [
              "type",
              "nodeId",
              "asset"
            ]
          }
        ]
      },
      "minItems": 1,
      "maxItems": 100
    }
  },
  "required": [
    "id",
    "baseRevision",
    "actor",
    "operations"
  ],
  "$defs": {
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number",
          "minimum": -100,
          "maximum": 200
        },
        "y": {
          "type": "number",
          "minimum": -100,
          "maximum": 200
        },
        "width": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 200
        },
        "height": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 200
        },
        "rotation": {
          "type": "number",
          "minimum": -360,
          "maximum": 360
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ]
    },
    "partialLayout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number",
          "minimum": -100,
          "maximum": 200
        },
        "y": {
          "type": "number",
          "minimum": -100,
          "maximum": 200
        },
        "width": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 200
        },
        "height": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 200
        },
        "rotation": {
          "type": "number",
          "minimum": -360,
          "maximum": 360
        }
      },
      "required": []
    },
    "override": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "layout": {
          "$ref": "#/$defs/partialLayout"
        },
        "protected": {
          "type": "boolean"
        }
      },
      "required": [
        "layout",
        "protected"
      ]
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "accent": {
          "type": "string",
          "pattern": "^(#(?:[a-fA-F0-9]{3}|[a-fA-F0-9]{4}|[a-fA-F0-9]{6}|[a-fA-F0-9]{8})|[a-zA-Z]{1,24})$"
        },
        "background": {
          "type": "string",
          "pattern": "^(#(?:[a-fA-F0-9]{3}|[a-fA-F0-9]{4}|[a-fA-F0-9]{6}|[a-fA-F0-9]{8})|[a-zA-Z]{1,24})$"
        },
        "foreground": {
          "type": "string",
          "pattern": "^(#(?:[a-fA-F0-9]{3}|[a-fA-F0-9]{4}|[a-fA-F0-9]{6}|[a-fA-F0-9]{8})|[a-zA-Z]{1,24})$"
        },
        "fontFamily": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "name",
        "accent",
        "background",
        "foreground",
        "fontFamily"
      ]
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,95}$"
        },
        "type": {
          "enum": [
            "image",
            "audio",
            "video",
            "font"
          ]
        },
        "src": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "Workspace-relative safe path, or HTTP(S) URL. The runtime additionally rejects absolute paths, traversal, controls, and unsupported schemes."
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "license": {
          "type": "string",
          "maxLength": 200
        }
      },
      "required": [
        "id",
        "type",
        "src"
      ]
    },
    "sentence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,95}$"
        },
        "text": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(?:-[A-Za-z]{2,8})?$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 4000
          }
        },
        "duration": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(?:-[A-Za-z]{2,8})?$"
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0.2,
            "maximum": 120
          }
        },
        "audioAssetId": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(?:-[A-Za-z]{2,8})?$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,95}$"
          }
        }
      },
      "required": [
        "id",
        "text",
        "duration"
      ]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,95}$"
        },
        "type": {
          "enum": [
            "text",
            "media",
            "card",
            "caption",
            "cta",
            "component"
          ]
        },
        "role": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,95}$"
        },
        "content": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(?:-[A-Za-z]{2,8})?$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 4000
          }
        },
        "layout": {
          "$ref": "#/$defs/layout"
        },
        "overrides": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "16:9": {
              "$ref": "#/$defs/override"
            },
            "9:16": {
              "$ref": "#/$defs/override"
            }
          },
          "required": []
        },
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sentenceId": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,95}$"
            },
            "start": {
              "type": "number",
              "minimum": 0
            },
            "end": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "sentenceId"
          ]
        },
        "style": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fontSize": {
              "type": "number",
              "minimum": 8,
              "maximum": 300
            },
            "fontWeight": {
              "type": "number",
              "minimum": 100,
              "maximum": 900
            },
            "color": {
              "type": "string",
              "pattern": "^(#(?:[a-fA-F0-9]{3}|[a-fA-F0-9]{4}|[a-fA-F0-9]{6}|[a-fA-F0-9]{8})|[a-zA-Z]{1,24})$"
            },
            "align": {
              "enum": [
                "left",
                "center",
                "right"
              ]
            }
          },
          "required": []
        },
        "assetId": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,95}$"
        },
        "component": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,95}$"
        },
        "props": {
          "type": "object",
          "propertyNames": {
            "not": {
              "enum": [
                "__proto__",
                "prototype",
                "constructor"
              ]
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        "animation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enter": {
              "enum": [
                "rise",
                "scale",
                "slide",
                "fade"
              ]
            },
            "delay": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            }
          },
          "required": [
            "enter"
          ]
        }
      },
      "required": [
        "id",
        "type",
        "content",
        "layout",
        "timing"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "media"
              }
            }
          },
          "then": {
            "required": [
              "assetId"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "component"
              }
            }
          },
          "then": {
            "required": [
              "component"
            ]
          }
        }
      ]
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,95}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "kind": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,95}$"
        },
        "theme": {
          "enum": [
            "brand",
            "inverted"
          ]
        },
        "sentences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sentence"
          },
          "minItems": 1,
          "maxItems": 100
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          },
          "minItems": 0,
          "maxItems": 500
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "sentences",
        "nodes"
      ]
    },
    "jsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string",
          "maxLength": 100000
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "not": {
              "enum": [
                "__proto__",
                "prototype",
                "constructor"
              ]
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      ]
    }
  }
}
