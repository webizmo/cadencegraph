{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cadencegraph:project:1",
  "title": "CadenceGraph Project v1",
  "description": "Portable project graph. Runtime validation also enforces unique IDs, locale completeness, references and sentence timing.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,95}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "locales": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2,3}(?:-[A-Za-z]{2,8})?$"
      },
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true
    },
    "ratios": {
      "type": "array",
      "items": {
        "enum": [
          "16:9",
          "9:16"
        ]
      },
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true
    },
    "fps": {
      "enum": [
        24,
        25,
        30,
        50,
        60
      ]
    },
    "brand": {
      "$ref": "#/$defs/brand"
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      },
      "minItems": 0,
      "maxItems": 500
    },
    "scenes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scene"
      },
      "minItems": 1,
      "maxItems": 100
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "revision",
    "locales",
    "ratios",
    "fps",
    "brand",
    "assets",
    "scenes"
  ],
  "$defs": {
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number",
          "minimum": -100,
          "maximum": 200
        },
        "y": {
          "type": "number",
          "minimum": -100,
          "maximum": 200
        },
        "width": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 200
        },
        "height": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 200
        },
        "rotation": {
          "type": "number",
          "minimum": -360,
          "maximum": 360
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ]
    },
    "partialLayout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number",
          "minimum": -100,
          "maximum": 200
        },
        "y": {
          "type": "number",
          "minimum": -100,
          "maximum": 200
        },
        "width": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 200
        },
        "height": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 200
        },
        "rotation": {
          "type": "number",
          "minimum": -360,
          "maximum": 360
        }
      },
      "required": []
    },
    "override": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "layout": {
          "$ref": "#/$defs/partialLayout"
        },
        "protected": {
          "type": "boolean"
        }
      },
      "required": [
        "layout",
        "protected"
      ]
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "accent": {
          "type": "string",
          "pattern": "^(#(?:[a-fA-F0-9]{3}|[a-fA-F0-9]{4}|[a-fA-F0-9]{6}|[a-fA-F0-9]{8})|[a-zA-Z]{1,24})$"
        },
        "background": {
          "type": "string",
          "pattern": "^(#(?:[a-fA-F0-9]{3}|[a-fA-F0-9]{4}|[a-fA-F0-9]{6}|[a-fA-F0-9]{8})|[a-zA-Z]{1,24})$"
        },
        "foreground": {
          "type": "string",
          "pattern": "^(#(?:[a-fA-F0-9]{3}|[a-fA-F0-9]{4}|[a-fA-F0-9]{6}|[a-fA-F0-9]{8})|[a-zA-Z]{1,24})$"
        },
        "fontFamily": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "name",
        "accent",
        "background",
        "foreground",
        "fontFamily"
      ]
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,95}$"
        },
        "type": {
          "enum": [
            "image",
            "audio",
            "video",
            "font"
          ]
        },
        "src": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "Workspace-relative safe path, or HTTP(S) URL. The runtime additionally rejects absolute paths, traversal, controls, and unsupported schemes."
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "license": {
          "type": "string",
          "maxLength": 200
        }
      },
      "required": [
        "id",
        "type",
        "src"
      ]
    },
    "sentence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,95}$"
        },
        "text": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(?:-[A-Za-z]{2,8})?$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 4000
          }
        },
        "duration": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(?:-[A-Za-z]{2,8})?$"
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0.2,
            "maximum": 120
          }
        },
        "audioAssetId": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(?:-[A-Za-z]{2,8})?$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,95}$"
          }
        }
      },
      "required": [
        "id",
        "text",
        "duration"
      ]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,95}$"
        },
        "type": {
          "enum": [
            "text",
            "media",
            "card",
            "caption",
            "cta",
            "component"
          ]
        },
        "role": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,95}$"
        },
        "content": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(?:-[A-Za-z]{2,8})?$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 4000
          }
        },
        "layout": {
          "$ref": "#/$defs/layout"
        },
        "overrides": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "16:9": {
              "$ref": "#/$defs/override"
            },
            "9:16": {
              "$ref": "#/$defs/override"
            }
          },
          "required": []
        },
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sentenceId": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,95}$"
            },
            "start": {
              "type": "number",
              "minimum": 0
            },
            "end": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "sentenceId"
          ]
        },
        "style": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fontSize": {
              "type": "number",
              "minimum": 8,
              "maximum": 300
            },
            "fontWeight": {
              "type": "number",
              "minimum": 100,
              "maximum": 900
            },
            "color": {
              "type": "string",
              "pattern": "^(#(?:[a-fA-F0-9]{3}|[a-fA-F0-9]{4}|[a-fA-F0-9]{6}|[a-fA-F0-9]{8})|[a-zA-Z]{1,24})$"
            },
            "align": {
              "enum": [
                "left",
                "center",
                "right"
              ]
            }
          },
          "required": []
        },
        "assetId": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,95}$"
        },
        "component": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,95}$"
        },
        "props": {
          "type": "object",
          "propertyNames": {
            "not": {
              "enum": [
                "__proto__",
                "prototype",
                "constructor"
              ]
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        "animation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enter": {
              "enum": [
                "rise",
                "scale",
                "slide",
                "fade"
              ]
            },
            "delay": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            }
          },
          "required": [
            "enter"
          ]
        }
      },
      "required": [
        "id",
        "type",
        "content",
        "layout",
        "timing"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "media"
              }
            }
          },
          "then": {
            "required": [
              "assetId"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "component"
              }
            }
          },
          "then": {
            "required": [
              "component"
            ]
          }
        }
      ]
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,95}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "kind": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,95}$"
        },
        "theme": {
          "enum": [
            "brand",
            "inverted"
          ]
        },
        "sentences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sentence"
          },
          "minItems": 1,
          "maxItems": 100
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          },
          "minItems": 0,
          "maxItems": 500
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "sentences",
        "nodes"
      ]
    },
    "jsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string",
          "maxLength": 100000
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "not": {
              "enum": [
                "__proto__",
                "prototype",
                "constructor"
              ]
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      ]
    }
  }
}
